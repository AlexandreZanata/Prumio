<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. The OS (not Prumio) performs these backups, and only when the user
     enabled them in system settings. Rationale: docs/adr/0016-android-system-backup.md. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
